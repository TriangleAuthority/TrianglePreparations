<?xml version="1.0" encoding="UTF-8"?>
<!-- Preparations options (Options > Mods > Preparations), PREP-MENU: legacy 6.2's groups, ids, presets and
     ranges unchanged. Read by scripts/local/prep/config/prepConfig.ws, which also holds each option's default. -->
<UserConfig>
   
    <Group id="preparationsMeditation" displayName="Mods.mod_preparations.prep_meditation">
		<PresetsArray>
			<Preset id="0" displayName="prep_defaults">
				<Entry varId="prepDisallowMeditation" value="true"/>
				<Entry varId="prepDisallowCampFire" value="false"/>
				<Entry varId="prepDisallowFireSource" value="false"/>
				<Entry varId="prepDisallowLightSource" value="true"/>
				<Entry varId="prepDisallowInterior" value="false"/>
				<Entry varId="prepDisallowSettlement" value="false"/>
				<Entry varId="prepDisallowNPCs" value="false"/>
				<Entry varId="prepNpcDistance" value="20"/>
			</Preset>
			<Preset id="1" displayName="prep_friendly_meditation">
				<Entry varId="prepDisallowMeditation" value="false"/>
				<Entry varId="prepDisallowCampFire" value="false"/>
				<Entry varId="prepDisallowFireSource" value="false"/>
				<Entry varId="prepDisallowLightSource" value="true"/>
				<Entry varId="prepDisallowInterior" value="false"/>
				<Entry varId="prepDisallowSettlement" value="false"/>
				<Entry varId="prepDisallowNPCs" value="false"/>
				<Entry varId="prepNpcDistance" value="20"/>
			</Preset>
			<Preset id="2" displayName="prep_off">
				<Entry varId="prepDisallowMeditation" value="false"/>
				<Entry varId="prepDisallowCampFire" value="false"/>
				<Entry varId="prepDisallowFireSource" value="false"/>
				<Entry varId="prepDisallowLightSource" value="false"/>
				<Entry varId="prepDisallowInterior" value="false"/>
				<Entry varId="prepDisallowSettlement" value="false"/>
				<Entry varId="prepDisallowNPCs" value="false"/>
			</Preset>
		</PresetsArray>
        <VisibleVars>
			<Var id="prepDisallowMeditation" displayName="prep_disallowMeditation" displayType="TOGGLE"/>
			<Var id="prepDisallowCampFire" displayName="prep_disallowCampFire" displayType="TOGGLE"/>
			<Var id="prepDisallowFireSource" displayName="prep_disallowFireSource" displayType="TOGGLE"/>
			<Var id="prepDisallowLightSource" displayName="prep_disallowLightSource" displayType="TOGGLE"/>
			<Var id="prepDisallowInterior" displayName="prep_disallowInterior" displayType="TOGGLE"/>
